+/**
+ * Implements hook_user_logout().
+ */
+function samlauth_user_logout(AccountInterface $account) {
+
+  // Only attempt SAML logout for authenticated users.
+  if ($account->id() === 0) {
+    return;
+  }
+
+  /** @var \Drupal\samlauth\SamlService $saml_service */
+  $saml_service = \Drupal::service('samlauth.saml');
+
+  // Initiates IdP Single Logout if a SAML session exists;
+  // no-op otherwise.
+  $saml_service->logout(['/user/login']);
+}
